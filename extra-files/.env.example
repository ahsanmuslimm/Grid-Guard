# ThreatGuard AI - Configuration Template
# Copy this file to .env and fill in with your values
# DO NOT commit .env to version control (add to .gitignore)

# ============================================
# SPLUNK CONFIGURATION
# ============================================

# Splunk server hostname
SPLUNK_HOST=localhost

# Splunk management port (usually 8089)
SPLUNK_PORT=8089

# Splunk admin username
SPLUNK_USERNAME=admin

# Splunk admin password
SPLUNK_PASSWORD=changeme

# Splunk HTTP Event Collector token
# Generate in Splunk: Settings > Data Inputs > HTTP Event Collector
SPLUNK_HEC_TOKEN=your-hec-token-here

# Splunk HEC endpoint (usually 8088)
SPLUNK_HEC_PORT=8088

# Splunk index where alerts are stored
SPLUNK_INDEX=main

# Splunk app name (usually can be 'search')
SPLUNK_APP=search

# Time range for queries (e.g., 1h, 24h, 7d)
SPLUNK_TIME_RANGE=1h

# ============================================
# THREATGUARD AI CONFIGURATION
# ============================================

# Environment (development, testing, production)
ENVIRONMENT=development

# Debug mode (True/False)
DEBUG=True

# Port for Flask app
FLASK_PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# AI analysis interval in seconds
AI_ANALYSIS_INTERVAL=300

# Confidence threshold for alerts (0.0 to 1.0)
# Alerts below this are suppressed as likely false positives
CONFIDENCE_THRESHOLD=0.85

# ============================================
# THREAT DETECTION SETTINGS
# ============================================

# Threat detector model confidence (0.0 to 1.0)
THREAT_DETECTOR_CONFIDENCE=0.70

# Performance monitor sensitivity (low, medium, high)
PERF_MONITOR_SENSITIVITY=medium

# Correlation weight for threat + performance
CORRELATION_WEIGHT=0.50

# Enable adversarial defense (True/False)
ENABLE_ADVERSARIAL_DEFENSE=True

# ============================================
# ALERT SETTINGS
# ============================================

# Alert severity levels to send (low, medium, high, critical)
ALERT_LEVELS=high,critical

# Enable email alerts (True/False)
EMAIL_ALERTS_ENABLED=True

# Email recipient for alerts
EMAIL_RECIPIENT=security-team@company.com

# Email sender address
EMAIL_SENDER=threatguard@company.com

# SMTP server for emails
SMTP_SERVER=smtp.gmail.com

# SMTP port (usually 587 for TLS)
SMTP_PORT=587

# SMTP username
SMTP_USERNAME=your-email@gmail.com

# SMTP password
SMTP_PASSWORD=your-app-password

# Enable Slack alerts (True/False)
SLACK_ALERTS_ENABLED=False

# Slack webhook URL for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack channel for alerts
SLACK_CHANNEL=#security-alerts

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Database file path
DATABASE_URL=sqlite:///threatguard.db

# Database echo (True for debugging SQL)
DATABASE_ECHO=False

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/threatguard.log

# Max log file size in MB
LOG_MAX_SIZE=50

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# ============================================
# SECURITY SETTINGS
# ============================================

# Secret key for session management
SECRET_KEY=your-secret-key-change-in-production

# API key for external integrations (if needed)
API_KEY=your-api-key-here

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# FEATURE FLAGS
# ============================================

# Enable threat correlation analysis
FEATURE_CORRELATION=True

# Enable adversarial attack detection
FEATURE_ADVERSARIAL=True

# Enable performance-based alerts
FEATURE_PERF_ALERTS=True

# Enable automatic alert suppression
FEATURE_AUTO_SUPPRESS=True

# Enable threat investigation timeline
FEATURE_TIMELINE=True

# ============================================
# PERFORMANCE SETTINGS
# ============================================

# Max workers for concurrent analysis
MAX_WORKERS=4

# Cache timeout in seconds
CACHE_TIMEOUT=300

# API request timeout in seconds
REQUEST_TIMEOUT=30

# Batch processing size
BATCH_SIZE=1000

# ============================================
# NOTES
# ============================================

# 1. Generate HEC token in Splunk:
#    - Log into Splunk (http://localhost:8000)
#    - Settings → Data Inputs → HTTP Event Collector
#    - Click "Create New Token"
#    - Copy token value to SPLUNK_HEC_TOKEN
#
# 2. For Gmail SMTP:
#    - Enable 2-factor authentication
#    - Create "App Password" at myaccount.google.com
#    - Use app password (not regular password)
#
# 3. For Slack:
#    - Create incoming webhook at api.slack.com
#    - Copy webhook URL to SLACK_WEBHOOK_URL
#
# 4. Change SECRET_KEY in production:
#    - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
#    - Use unique, random value
#
# 5. Never commit .env to version control:
#    - Add to .gitignore
#    - Share configuration securely
#    - Use different values per environment

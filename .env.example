# GridGuard local configuration template
# Copy to .env and replace placeholder values. Never commit .env.

GRIDGUARD_ENV=development
GRIDGUARD_MODEL=gemini-3.5-flash-lite
PORT=8080
LOG_LEVEL=INFO
GRIDGUARD_RELOAD=false

# Local Gemini Developer API mode (does not require GCP billing)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your_google_ai_studio_api_key

# Phoenix Cloud space and trace project
PHOENIX_API_KEY='eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJqdGkiOiJBcGlLZXk6NCJ9.yDyOeAMpshRqUPW2jBDXLKRkK6V7aMAnAYRwium0Z7c'
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space-id
PHOENIX_BASE_URL=https://app.phoenix.arize.com/s/your-space-id
PHOENIX_PROJECT_NAME=Grid-Guard
# Keep these disabled until the collector/API checks succeed without HTTP 404.
GRIDGUARD_ENABLE_PHOENIX_TRACING=false
GRIDGUARD_ENABLE_PHOENIX_MCP=false

NVD_API_KEY=your_nvd_api_key
